{
  "expo": {
    "name": "TakaInsure",
    "slug": "TakaInsure",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "takainsure",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rakinzi.TakaInsure",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them for insurance claims."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "551688fc-6258-4099-9452-f89fdc59f876"
      }
    },
    "android": {
      "package": "com.rakinzi.TakaInsure",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    }
  }
}
